---
import BaseLayout from './BaseLayout.astro';
import { siteConfig } from '../data/site';
import type { Article } from '../data/articles';

interface Props {
  article: Article;
  relatedArticles?: Article[];
}

const { article, relatedArticles = [] } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.description,
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Organization",
    "name": siteConfig.author
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.url}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteConfig.url}/guides/${article.slug}/`
  }
};
---

<BaseLayout 
  title={`${article.title} - 闪电猫 SpeedCAT 官网`} 
  description={article.description}
  keywords={article.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>

  <div class="guide-header-banner">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">首页</a>
        <span class="sep">/</span>
        <a href="/guides/">使用教程与文章</a>
        <span class="sep">/</span>
        <span class="current">{article.category}</span>
      </nav>

      <h1 class="guide-post-title">{article.title}</h1>

      <div class="guide-post-meta">
        <span class="meta-item">发布日期: {article.date}</span>
        <span class="meta-sep">·</span>
        <span class="meta-item">阅读时间: {article.readTime}</span>
        <span class="meta-sep">·</span>
        <span class="meta-item category-badge">{article.category}</span>
      </div>
    </div>
  </div>

  <div class="container guide-content-wrapper">
    <article class="guide-main-article">
      <div class="guide-summary-box glass-card">
        <h3 class="summary-title">💡 文章核心概要</h3>
        <p>{article.summary}</p>
      </div>

      <div class="markdown-body">
        <slot />
      </div>

      <!-- Registration CTA inside article footer -->
      <div class="article-cta-box glass-card">
        <h3>🚀 准备好体验全专线极速科学上网了吗？</h3>
        <p>立刻注册闪电猫 SpeedCAT 控制台，获取最高速的 Clash 节点与 ClashParty 机场订阅。</p>
        <a 
          href={siteConfig.affUrl} 
          target={siteConfig.affTarget} 
          rel={siteConfig.affRel} 
          class="btn btn-cyan btn-lg"
        >
          前往闪电猫官网注册
        </a>
      </div>
    </article>

    <!-- Sidebar -->
    <aside class="guide-sidebar">
      <div class="sidebar-widget glass-card">
        <h4 class="widget-title">闪电猫 SpeedCAT 控制台</h4>
        <p class="widget-desc">全节点 IEPL 专线，秒开 4K 视频，完美支持 AI 生产力工具。</p>
        <a 
          href={siteConfig.affUrl} 
          target={siteConfig.affTarget} 
          rel={siteConfig.affRel} 
          class="btn btn-cyan btn-block"
        >
          立即注册控制台
        </a>
      </div>

      {relatedArticles.length > 0 && (
        <div class="sidebar-widget glass-card">
          <h4 class="widget-title">相关推荐阅读</h4>
          <ul class="related-list">
            {relatedArticles.map(rel => (
              <li>
                <a href={`/guides/${rel.slug}/`}>{rel.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<style>
  .guide-header-banner {
    background: radial-gradient(circle at 50% 0%, #172238 0%, #0B0F17 100%);
    padding: 50px 0 40px;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--color-text-subtle);
    margin-bottom: 18px;
  }

  .breadcrumb a {
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-electric-cyan);
  }

  .guide-post-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .guide-post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .category-badge {
    color: var(--color-electric-cyan);
    font-weight: 700;
  }

  .guide-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 40px;
    padding: 50px 24px;
  }

  .guide-summary-box {
    padding: 22px 26px;
    margin-bottom: 36px;
    border-left: 4px solid var(--color-electric-cyan);
  }

  .summary-title {
    font-size: 1.05rem;
    color: #FFFFFF;
    margin-bottom: 8px;
  }

  .markdown-body {
    font-size: 1.02rem;
    line-height: 1.85;
    color: #CBD5E1;
  }

  .markdown-body h2 {
    font-size: 1.55rem;
    color: #FFFFFF;
    margin: 36px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  .markdown-body h3 {
    font-size: 1.25rem;
    color: #F1F5F9;
    margin: 28px 0 14px;
  }

  .markdown-body p {
    margin-bottom: 20px;
  }

  .markdown-body ul, .markdown-body ol {
    margin: 0 0 20px 24px;
  }

  .markdown-body li {
    margin-bottom: 8px;
  }

  .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
  }

  .markdown-body th, .markdown-body td {
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    font-size: 0.92rem;
  }

  .markdown-body th {
    background: rgba(34, 211, 238, 0.1);
    color: #FFFFFF;
  }

  .article-cta-box {
    padding: 32px;
    text-align: center;
    margin-top: 50px;
    border: 1px solid var(--color-border-bright);
    box-shadow: var(--shadow-glow-cyan);
  }

  .article-cta-box h3 {
    font-size: 1.4rem;
    color: #FFFFFF;
    margin-bottom: 10px;
  }

  .article-cta-box p {
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .sidebar-widget {
    padding: 24px;
    margin-bottom: 24px;
  }

  .widget-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 12px;
  }

  .widget-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-bottom: 18px;
    line-height: 1.6;
  }

  .related-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-list a {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: block;
  }

  .related-list a:hover {
    color: var(--color-electric-cyan);
  }

  @media (max-width: 900px) {
    .guide-content-wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>
