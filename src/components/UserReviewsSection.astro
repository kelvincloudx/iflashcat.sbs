---
import { reviewList } from '../data/reviews';
---

<section class="reviews-section" id="reviews">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">真实口碑认证</span>
      <h2 class="section-title">
        数万用户的信赖选择 <br/>
        <span class="gradient-text">听听大家对闪电猫稳定节点的评价</span>
      </h2>
      <p class="section-desc">
        无论是一线开发工程师、跨境外贸运营专家，还是重度影音玩家，闪电猫 SpeedCAT 都获得了极高的满意度评价。
      </p>
    </div>

    <div class="reviews-grid">
      {reviewList.map(review => (
        <div class="review-card glass-card">
          <div class="review-top">
            <div class="user-info">
              <img src={review.avatar} alt={review.name} class="user-avatar" />
              <div class="user-details">
                <h4 class="user-name">{review.name}</h4>
                <p class="user-role">{review.role}</p>
              </div>
            </div>
            <div class="review-tag">{review.tag}</div>
          </div>

          <div class="star-rating">
            {Array.from({ length: review.rating }).map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="1">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          <p class="review-content">
            “{review.content}”
          </p>

          <div class="review-footer">
            <span class="plan-used">订阅方案: {review.planName}</span>
            <span class="review-date">{review.date}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 85px 0;
    background: var(--color-bg);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .review-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
  }

  .review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .user-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid var(--color-electric-cyan);
  }

  .user-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: #FFFFFF;
  }

  .user-role {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .review-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #10B981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .star-rating {
    display: flex;
    gap: 4px;
    margin-bottom: 14px;
  }

  .review-content {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #E2E8F0;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .review-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
    font-size: 0.82rem;
  }

  .plan-used {
    color: var(--color-electric-cyan);
    font-weight: 600;
  }

  .review-date {
    color: var(--color-text-subtle);
  }

  @media (max-width: 768px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
