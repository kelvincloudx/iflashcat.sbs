---
import { siteConfig } from '../data/site';
---

<section class="hero-section">
  <div class="hero-glow hero-glow-cyan"></div>
  <div class="hero-glow hero-glow-purple"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>2026 全网推荐・便宜安全机场与稳定节点首选</span>
      </div>

      <h1 class="hero-title">
        闪电猫 SpeedCAT <br/>
        <span class="gradient-text">极速科学上网与魔法梯子全球加速</span>
      </h1>

      <p class="hero-desc">
        闪电猫 SpeedCAT 采用广深/上海全节点 IEPL 专线架构，全量支持 <strong>Clash 节点</strong> 与 <strong>ClashParty 机场</strong> 托管订阅。专为 <strong>翻墙出海</strong>、4K/8K 海外影音、ChatGPT/Claude AI 工具与跨境办公打造，提供高可靠的 <strong>稳定节点</strong> 与 <strong>全球加速</strong> 服务。
      </p>

      <div class="hero-actions">
        <a 
          href={siteConfig.affUrl} 
          target={siteConfig.affTarget} 
          rel={siteConfig.affRel} 
          class="btn btn-cyan btn-lg hero-main-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span>前往闪电猫官网注册</span>
        </a>

        <a href="/pricing/" class="btn btn-outline btn-lg">
          <span>查看套餐价格 (¥20起)</span>
        </a>
      </div>

      <!-- Feature Badges Row -->
      <div class="hero-features">
        <div class="feature-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22D3EE" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>安全机场保障</span>
        </div>
        <div class="feature-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22D3EE" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          <span>IEPL 专线稳定节点</span>
        </div>
        <div class="feature-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22D3EE" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8"/>
          </svg>
          <span>4K/8K 零缓冲视频</span>
        </div>
        <div class="feature-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22D3EE" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
            <line x1="8" y1="21" x2="16" y2="21"/>
            <line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
          <span>Clash / ClashParty 一键导入</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 90px 0 70px;
    overflow: hidden;
    background: radial-gradient(circle at 50% 20%, #131B2E 0%, #0B0F17 70%);
  }

  .hero-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
    opacity: 0.35;
  }

  .hero-glow-cyan {
    top: -100px;
    left: 15%;
    background: #06B6D4;
  }

  .hero-glow-purple {
    top: 50px;
    right: 15%;
    background: #7C3AED;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 920px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-electric-cyan);
    margin-bottom: 24px;
    box-shadow: 0 0 15px rgba(34, 211, 238, 0.15);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22D3EE;
    box-shadow: 0 0 8px #22D3EE;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .hero-title {
    font-size: 3.2rem;
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 22px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #22D3EE 0%, #A855F7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }

  .hero-features {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .feature-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(19, 26, 41, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    color: #CBD5E1;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 60px 0 50px;
    }
    .hero-title {
      font-size: 2.1rem;
    }
    .hero-desc {
      font-size: 1rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
