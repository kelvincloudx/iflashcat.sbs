---
import { siteConfig } from '../data/site';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-logo">
      <div class="logo-icon">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="19" fill="#131A29" stroke="#22D3EE" stroke-width="2"/>
          <path d="M12 15L15 23H25L28 15L23 18H17L12 15Z" fill="#7C3AED"/>
          <path d="M22 10L14 22H21L18 30L27 18H20L22 10Z" fill="#22D3EE"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">闪电猫</span>
        <span class="brand-sub">SpeedCAT.sbs</span>
      </div>
    </a>

    <nav class="desktop-nav">
      {siteConfig.navItems.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a href={item.href} class={`nav-link ${isActive ? 'active' : ''}`}>
            {item.name}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <a 
        href={siteConfig.affUrl} 
        target={siteConfig.affTarget} 
        rel={siteConfig.affRel} 
        class="btn btn-cyan btn-sm header-cta"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M15 3h6v6M10 14L21 3M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
        </svg>
        <span>控制台登录 / 注册</span>
      </a>

      <button class="mobile-toggle" id="mobile-toggle-btn" aria-label="Toggle navigation">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path class="menu-open-icon" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div class="mobile-nav" id="mobile-menu">
    <nav class="mobile-nav-links">
      {siteConfig.navItems.map(item => (
        <a href={item.href} class="mobile-nav-link">
          {item.name}
        </a>
      ))}
      <a 
        href={siteConfig.affUrl} 
        target={siteConfig.affTarget} 
        rel={siteConfig.affRel} 
        class="btn btn-cyan btn-lg mobile-cta"
      >
        控制台登录 / 注册入口
      </a>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('open');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(11, 15, 23, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none !important;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: 1.2rem;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-electric-cyan);
    letter-spacing: 0.05em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: all 0.2s ease;
    padding: 6px 0;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: #FFFFFF;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-electric-cyan);
    border-radius: 2px;
    box-shadow: 0 0 8px var(--color-electric-cyan);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: #FFFFFF;
    cursor: pointer;
    padding: 6px;
  }

  .mobile-nav {
    display: none;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 20px;
  }

  .mobile-nav.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-nav-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-main);
    padding: 8px 0;
  }

  .mobile-cta {
    margin-top: 12px;
    width: 100%;
    text-align: center;
  }

  @media (max-width: 868px) {
    .desktop-nav {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
    .header-cta {
      display: none;
    }
  }
</style>
