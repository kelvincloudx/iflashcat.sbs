---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Brand Info -->
      <div class="footer-brand">
        <div class="brand-header">
          <div class="footer-logo-icon">
            <svg width="28" height="28" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="20" cy="20" r="19" fill="#131A29" stroke="#22D3EE" stroke-width="2"/>
              <path d="M12 15L15 23H25L28 15L23 18H17L12 15Z" fill="#7C3AED"/>
              <path d="M22 10L14 22H21L18 30L27 18H20L22 10Z" fill="#22D3EE"/>
            </svg>
          </div>
          <div class="footer-brand-title">
            <span class="footer-brand-name">闪电猫 SpeedCAT</span>
            <span class="footer-brand-domain">iflashcat.sbs</span>
          </div>
        </div>
        <p class="footer-desc">
          闪电猫 SpeedCAT 官方授权落地页。提供便宜安全机场推荐、专线稳定节点、Clash / ClashParty 托管订阅配置，全效保障翻墙出海与全球加速体验。
        </p>
        <div class="footer-aff-action">
          <a 
            href={siteConfig.affUrl} 
            target={siteConfig.affTarget} 
            rel={siteConfig.affRel} 
            class="btn btn-cyan btn-sm"
          >
            {siteConfig.affButtonText}
          </a>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="footer-nav">
        <h3 class="footer-heading">站内导航</h3>
        <ul class="footer-links">
          {siteConfig.navItems.map(item => (
            <li>
              <a href={item.href} class="footer-link">{item.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Featured Articles Links -->
      <div class="footer-guides">
        <h3 class="footer-heading">精选教程与指南</h3>
        <ul class="footer-links">
          <li><a href="/guides/speedcat-first-purchase/" class="footer-link">便宜机场与安全机场选购</a></li>
          <li><a href="/guides/speedcat-plan-cycles/" class="footer-link">7大套餐价格与流量重置</a></li>
          <li><a href="/guides/speedcat-subscription-management/" class="footer-link">Clash / ClashParty 订阅教程</a></li>
          <li><a href="/guides/speedcat-devices/" class="footer-link">多设备全平台稳定节点配置</a></li>
          <li><a href="/guides/speedcat-streaming-ai/" class="footer-link">4K流媒体与AI工具加速测评</a></li>
        </ul>
      </div>
    </div>

    <!-- Disclaimer Box -->
    <div class="footer-disclaimer-card">
      <div class="disclaimer-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>服务与免责声明</span>
      </div>
      <p class="disclaimer-content">
        {siteConfig.footerDisclaimer} 套餐价格与权益均以购买控制台最终公示为准。请合规使用网络资源，遵守所在国家与地区的法律法规。
      </p>
    </div>

    <!-- PBN Friendly Links Area (核心任务 2: 低调美观小字号 dofollow 链接) -->
    <div class="pbn-friendly-links">
      <a href="https://jichangreview.net" target="_blank" class="pbn-link">机场测评</a>
      <span class="pbn-divider">|</span>
      <a href="https://jichangguide.net" target="_blank" class="pbn-link">机场教程</a>
    </div>

    <!-- Copyright Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © 2026 闪电猫 SpeedCAT (iflashcat.sbs). 版权所有｜全节点专线全球加速技术支持
      </p>
      <div class="footer-bottom-links">
        <a href="/pricing/">参考价格表</a>
        <span class="separator">·</span>
        <a href="/faq/">常见问题解答</a>
        <span class="separator">·</span>
        <a href="/guides/">使用配置指南</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-midnight);
    color: #94A3B8;
    padding: 70px 0 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.4), rgba(124, 58, 237, 0.4), transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1.4fr;
    gap: 48px;
    margin-bottom: 40px;
  }

  .footer-brand {
    padding-right: 20px;
  }

  .brand-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .footer-brand-title {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .footer-brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
  }

  .footer-brand-domain {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-electric-cyan);
    letter-spacing: 0.08em;
  }

  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #94A3B8;
    margin-bottom: 20px;
  }

  .footer-heading {
    color: #FFFFFF;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 0.9rem;
    color: #94A3B8;
    transition: all 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-electric-cyan);
    padding-left: 4px;
  }

  .footer-disclaimer-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-md);
    padding: 18px 22px;
    margin-bottom: 30px;
  }

  .disclaimer-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 700;
    color: #FBBF24;
    margin-bottom: 8px;
  }

  .disclaimer-content {
    font-size: 0.88rem;
    line-height: 1.65;
    color: #CBD5E1;
    margin: 0;
  }

  /* PBN 友情链接 CSS (低调、美观、小字号、dofollow) */
  .pbn-friendly-links {
    text-align: center;
    padding: 16px 0;
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pbn-label {
    color: #475569;
  }

  .pbn-link {
    color: #94A3B8 !important;
    text-decoration: none;
    font-size: 0.8rem;
    transition: color 0.2s ease;
  }

  .pbn-link:hover {
    color: var(--color-electric-cyan) !important;
    text-shadow: 0 0 6px rgba(34, 211, 238, 0.4);
  }

  .pbn-divider {
    color: #334155;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
  }

  .copyright {
    color: #64748B;
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-bottom-links a {
    color: #94A3B8;
  }

  .footer-bottom-links a:hover {
    color: var(--color-electric-cyan);
  }

  .separator {
    color: #475569;
  }

  @media (max-width: 992px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    .footer-brand {
      grid-column: 1 / -1;
      padding-right: 0;
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding: 50px 0 25px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }
</style>
